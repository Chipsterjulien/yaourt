msgctxt "help.title"
msgid "{name} {version} — pacman wrapper + AUR helper"
msgstr "{name} {version} — интерфейс за pacman + помощник за AUR"

msgctxt "help.usage"
msgid "USAGE:"
msgstr "УПОТРЕБА:"

msgctxt "help.delegate"
msgid "delegate to pacman (-Q, -R, -Sy…)"
msgstr "предава операциите на pacman (-Q, -R, -Sy…)"

msgctxt "help.install"
msgid "install a package (repositories or AUR)"
msgstr "инсталира пакет (хранилища или AUR)"

msgctxt "help.search"
msgid "search repositories and AUR"
msgstr "търси в хранилищата и AUR"

msgctxt "help.update"
msgid "update repositories and AUR ([M]: manually select AUR packages)"
msgstr "актуализира хранилищата и AUR ([M]: ръчен избор на AUR пакети)"

msgctxt "help.clean"
msgid "clean the build cache (soft | complete)"
msgstr "изчиства кеша за компилация (частично | напълно)"

msgctxt "help.get_build_files"
msgid "retrieve AUR build files (git clone)"
msgstr "изтегля файловете за компилация от AUR (git clone)"

msgctxt "help.show_help"
msgid "show this help"
msgstr "показва тази помощ"

msgctxt "help.show_version"
msgid "show the version"
msgstr "показва версията"

msgctxt "app.system_user_missing"
msgid "The “yaourt” system user could not be found."
msgstr "Потребителят на системата \"yaourt\" не може да бъде намерен."

msgctxt "app.system_user_create"
msgid "Create it (as root):"
msgstr "Създайте го (като root):"

msgctxt "aur.package_not_found"
msgid "{package}: not found in the AUR"
msgstr "{package}: не се съдържа в AUR"

msgctxt "aur.rpc_error"
msgid "RPC error"
msgstr "RPC грешка"

msgctxt "build.heading"
msgid "Build package {package}"
msgstr "Съставяне на софтуерен пакет {package}"

msgctxt "build.heading_update"
msgid "Build package {package} ({old_version} -> {new_version})"
msgstr "Съставяне на софтуерния пакет {package} ({old_version} -> {new_version})"

msgctxt "build.heading_new"
msgid "Build package {package} (new installation {version})"
msgstr "Съставяйте софтуерния пакет {package} (нова инсталация {version})"

msgctxt "build.heading_installed"
msgid "Build package {package} ({version})"
msgstr "Съставяне на софтуерния пакет {package} ({version})"

msgctxt "build.makepkg_failed"
msgid "build failed (makepkg)"
msgstr "Изключено съставяне на софтуера (makepkg)"

