msgctxt "help.title"
msgid "{name} {version} — pacman wrapper + AUR helper"
msgstr "{name} {version} — pacman-viðmót + AUR-aðstoð"

msgctxt "help.usage"
msgid "USAGE:"
msgstr "NOTKUN:"

