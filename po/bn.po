msgid_plural "AUR packages to watch ({count})"
msgstr[0] "AUR সফটওয়্যার প্যাকেজ ({count})"
msgstr[1] "AUR সফটওয়্যার প্যাকেজগুলি দেখার জন্য ({count})"

msgctxt "update.aur_unmanaged"
msgid "Package not managed by the AUR ({count})"
msgid_plural "Packages not managed by the AUR ({count})"
msgstr[0] "AUR ({count}) দ্বারা পরিচালিত নয় এমন সফ্টওয়্যার প্যাকেজ"
msgstr[1] "AUR ({count}) দ্বারা পরিচালিত নয় এমন সফটওয়্যার প্যাকেজ"

msgctxt "update.continue"
msgid "Continue the update?"
msgstr "আপডেট চালিয়ে যান?"

msgctxt "update.continue_manual"
msgid "Continue the update?"
msgstr "আপডেট চালিয়ে যান?"

msgctxt "update.new_versions"
msgid "Software update (new version) ({count} package):"
msgid_plural "Software updates (new version) ({count} packages):"
msgstr[0] "সফটওয়্যার আপডেট (নতুন সংস্করণ) ({count} সফটওয়্যার প্যাকেজ):"
msgstr[1] "সফটওয়্যার আপডেট (নতুন সংস্করণ) ({count} সফটওয়্যার প্যাকেজ):"

msgctxt "update.revisions"
msgid "New package revision ({count} package):"
msgid_plural "New package revisions ({count} packages):"
msgstr[0] "নতুন সফটওয়্যার প্যাকেজ সংশোধন ({count} সফটওয়্যার প্যাকেজ):"
msgstr[1] "নতুন সফটওয়্যার প্যাকেজ সংশোধন ({count} সফটওয়্যার প্যাকেজ):"

msgctxt "update.select_aur"
msgid "Select the AUR packages to update"
msgstr "আপডেট করার জন্য AUR সফটওয়্যার প্যাকেজ নির্বাচন করুন"

msgctxt "update.selection_prompt"
msgid "Numbers to update (e.g. 1 3 5, 1-4, ^2 for all except 2):"
msgstr "আপডেট করার জন্য নম্বর (উদাহরণস্বরূপ, 1 3 5, 1-4, ^2 - 2 ব্যতীত)"

msgctxt "update.sync_failed"
msgid "failed to synchronize databases (pacman -Sy)"
msgstr "ডাটাবেস সিঙ্ক্রোনাইজ করতে ব্যর্থ হয়েছে (pacman -Sy)"

msgctxt "update.up_to_date"
msgid "The system is up to date."
msgstr "সিস্টেম আপ টু ডেট।"
