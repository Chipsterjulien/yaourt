msgctxt "cache.pacman_full"
msgid "pacman cache (complete)"
msgstr "pacman cache (bọn)"

msgctxt "cache.remove_confirm"
msgid "Confirm removal of all repositories?"
msgstr "Tiếp tục xóa tất cả các kho lưu trữ?"

msgctxt "cache.remove_failed"
msgid "could not remove {path}: {error}"
msgstr "không thể loại bỏ {path}: {error}"

msgctxt "cache.remove_full"
msgid "COMPLETE removal of the build cache ({count} package)"
msgid_plural "COMPLETE removal of the build cache ({count} packages)"
msgstr[0] "Lưu trữ bộ nhớ cache xây dựng phần mềm ({count} gói phần mềm)"

msgctxt "cache.remove_skipped"
msgid "AUR removal skipped."
msgstr "Việc loại bỏ AUR bị bỏ qua."

msgctxt "cache.remove_untracked"
msgid "Remove files not tracked by Git from every repository?"
msgstr "Xóa các tệp không được theo dõi bởi Git từ mọi kho lưu trữ?"

msgctxt "cache.remove_warning"
msgid "All cloned repositories will be removed (they will be cloned again on the next build)."
msgstr "Tất cả các kho lưu trữ được sao chép sẽ được loại bỏ (bạn sẽ được sao chép lại trong xây dựng tiếp theo)."

msgctxt "cache.removed"
msgid "{count} repository removed."
msgid_plural "{count} repositories removed."
msgstr[0] "Các kho lưu trữ {count} bị xóa."

msgctxt "cli.package_required"
msgid "{option} expects at least one package name"
msgstr "{option} mong đợi ít nhất một tên gói phần mềm"

msgctxt "cli.search_term_required"
msgid "{option} expects a search term"
msgstr "{option} mong đợi một thuật ngữ tìm kiếm"

