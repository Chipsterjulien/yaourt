msgctxt "help.title"
msgid "{name} {version} — pacman wrapper + AUR helper"
msgstr "{name} {version} — giao diện pacman + trợ lý AUR"

msgctxt "help.usage"
msgid "USAGE:"
msgstr "CÁCH DÙNG:"

msgctxt "help.delegate"
msgid "delegate to pacman (-Q, -R, -Sy…)"
msgstr "chuyển thao tác cho pacman (-Q, -R, -Sy…)"

msgctxt "help.install"
msgid "install a package (repositories or AUR)"
msgstr "cài đặt gói (kho phần mềm hoặc AUR)"

msgctxt "help.search"
msgid "search repositories and AUR"
msgstr "tìm kiếm trong kho phần mềm và AUR"

msgctxt "help.update"
msgid "update repositories and AUR ([M]: manually select AUR packages)"
msgstr "cập nhật kho phần mềm và AUR ([M]: chọn thủ công các gói AUR)"

msgctxt "help.clean"
msgid "clean the build cache (soft | complete)"
msgstr "dọn bộ nhớ đệm bản dựng (một phần | toàn bộ)"

msgctxt "help.get_build_files"
msgid "retrieve AUR build files (git clone)"
msgstr "lấy tệp bản dựng AUR (git clone)"

msgctxt "help.show_help"
msgid "show this help"
msgstr "hiển thị trợ giúp này"

msgctxt "help.show_version"
msgid "show the version"
msgstr "hiển thị phiên bản"

msgctxt "app.system_user_missing"
msgid "The “yaourt” system user could not be found."
msgstr "Người dùng hệ thống \"yaourt\" không thể được tìm thấy."

msgctxt "app.system_user_create"
msgid "Create it (as root):"
msgstr "Tạo nó (như root):"

msgctxt "aur.package_not_found"
msgid "{package}: not found in the AUR"
msgstr "{package}: không có trong AUR"

msgctxt "aur.rpc_error"
msgid "RPC error"
msgstr "lỗi RPC"

msgctxt "build.heading"
msgid "Build package {package}"
msgstr "Sắp xếp gói phần mềm {package}"

msgctxt "build.heading_update"
msgid "Build package {package} ({old_version} -> {new_version})"
msgstr "Chuẩn bị gói phần mềm {package} ({old_version} -> {new_version})"

msgctxt "build.heading_new"
msgid "Build package {package} (new installation {version})"
msgstr "Thiết lập gói phần mềm {package} (trình cài đặt mới {version})"

msgctxt "build.heading_installed"
msgid "Build package {package} ({version})"
msgstr "Sắp ráp gói phần mềm {package} ({version})"

msgctxt "build.makepkg_failed"
msgid "build failed (makepkg)"
msgstr "Việc biên soạn phần mềm thất bại (makepkg)"

msgctxt "build.pkgbuild_missing"
msgid "{package}: PKGBUILD not found"
msgstr "{package}: PKGBUILD không tìm thấy"

msgctxt "build.remove_package_failed"
msgid "could not remove package {path}: {error}"
msgstr "không thể xóa gói phần mềm {path}: {error}"

msgctxt "build.remove_stale_failed"
msgid "could not remove stale package {path}: {error}"
msgstr "không thể loại bỏ gói phần mềm cũ {path}: {error}"

msgctxt "build.user_missing"
msgid "The {user} user could not be found: {error}"
msgstr "Người dùng {user} không thể tìm thấy: {error}"

msgctxt "cache.absent"
msgid "Build cache not found ({path}): nothing to clean."
msgstr "Phần mềm xây dựng cache không tìm thấy ({path}): không có gì để làm sạch."

msgctxt "cache.clean_failed"
msgid "failed to clean {path}"
msgstr "không làm sạch {path}"

msgctxt "cache.clean_skipped"
msgid "AUR cleanup skipped."
msgstr "Việc dọn dẹp AUR bị bỏ qua."

msgctxt "cache.clean_sources"
msgid "Cleaning build sources ({count} package)"
msgid_plural "Cleaning build sources ({count} packages)"
msgstr[0] "Các nguồn xây dựng phần mềm làm sạch ({count} gói phần mềm)"

msgctxt "cache.cleaned"
msgid "{count} repository cleaned."
msgid_plural "{count} repositories cleaned."
msgstr[0] "Các kho lưu trữ {count} được dọn sạch."

msgctxt "cache.empty"
msgid "Build cache is empty: nothing to clean on the AUR side."
msgstr "Cache xây dựng phần mềm là trống rỗng: không có gì để làm sạch trên phía AUR."

msgctxt "cache.inspect_failed"
msgid "could not inspect the build cache: {error}"
msgstr "không thể kiểm tra bộ nhớ cache xây dựng phần mềm: {error}"

msgctxt "cache.list_failed"
msgid "could not list the build cache: {error}"
msgstr "không thể liệt kê cache xây dựng phần mềm: {error}"

msgctxt "cache.pacman"
msgid "pacman cache"
