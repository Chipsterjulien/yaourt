# Mainteneur : toi
# PKGBUILD de départ — binaire autonome Babet et catalogues gettext.
#
# Note : construit ici depuis l'arbre de travail local (dev). Pour une vraie
# distribution, ajouter une source VCS (git+...) et bâtir depuis $srcdir.

pkgname=yaourt
pkgver=0.11.0
pkgrel=1
pkgdesc="Wrapper pacman + assistant AUR (réécriture Lua/babet)"
arch=('x86_64' 'aarch64')
url="https://github.com/Chipsterjulien/yaourt"
license=('GPL')

depends=('pacman' 'pacman-contrib' 'git' 'sudo')

# babet nécessaire pour empaqueter le binaire.
#
# TODO (packaging) : récupérer le binaire babet pour $CARCH (x86_64 /
# aarch64) depuis les releases GitHub au lieu de l'assumer présent :
#   https://github.com/Chipsterjulien/babet/releases
# Pour l'instant on travaille avec le bon binaire babet directement.
makedepends=('babet>=2.24.0' 'gettext' 'python')

# Racine du projet (le dossier parent de packaging/).
_root="$(realpath "$(dirname "$BASH_SOURCE")/..")"

build() {
  cd "$_root"
  ./build.sh "$srcdir/$pkgname"
}

package() {
  install -Dm755 "$srcdir/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$_root/config.example.toml" \
    "$pkgdir/usr/share/$pkgname/config.example.toml"
  install -Dm644 "$_root/config.example.fr.toml" \
    "$pkgdir/usr/share/$pkgname/config.example.fr.toml"

  # Catalogues gettext externes. Le binaire contient les mêmes traductions,
  # mais ces fichiers permettent aux mainteneurs de les actualiser sans
  # toucher au moteur ni à la logique métier.
  local po locale
  for po in "$_root"/po/*.po; do
    locale="$(basename "${po%.po}")"
    install -d "$pkgdir/usr/share/locale/$locale/LC_MESSAGES"
    msgfmt --check --check-format \
      -o "$pkgdir/usr/share/locale/$locale/LC_MESSAGES/yaourt.mo" \
      "$po"
  done

  # Création automatique de l'utilisateur système de build et de son répertoire.
  # Les hooks pacman systemd-sysusers / systemd-tmpfiles les appliquent à
  # l'installation, sans intervention manuelle.
  install -Dm644 "$_root/packaging/$pkgname.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -Dm644 "$_root/packaging/$pkgname.tmpfiles" \
    "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
}
